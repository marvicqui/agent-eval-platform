# ── Azure / Microsoft Foundry ─────────────────────────────────────────────
# Authentication is DefaultAzureCredential (az login / managed identity).
# There is deliberately NO AZURE_OPENAI_API_KEY variable: keys are not used.

# Foundry (AIServices) resource name and its resource group
AZURE_AI_RESOURCE=
AZURE_AI_RG=

# Azure OpenAI endpoint, e.g. https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=

# Model deployment names (as deployed in Foundry, not model names)
AEP_SUT_DEPLOYMENT=gpt-small
AEP_JUDGE_DEPLOYMENT=gpt-small
AEP_EMBEDDINGS_DEPLOYMENT=embeddings

# ── Langfuse Cloud (OTLP export target) ───────────────────────────────────
# Settings → API Keys in your Langfuse project. Local only — never commit .env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Runner ────────────────────────────────────────────────────────────────
# Max concurrent cases against the SUT; keeps Foundry rate limits happy.
AEP_MAX_CONCURRENCY=4

# Judge model must differ from the SUT model (self-preference bias guard).
# Set to 1 ONLY to accept the documented limitation while a second model
# deployment is unavailable.
AEP_ALLOW_SAME_JUDGE=

# RAGAS evaluator deployment — its NAME must match the model it runs (see config.py)
AEP_RAGAS_DEPLOYMENT=gpt-5-mini
